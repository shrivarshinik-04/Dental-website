# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database. SQLite for development; for production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/clinic?sslmode=require"
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# AES-256-GCM key for personal and health fields (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes the encrypted data unreadable: store it in a secrets manager
# and back it up separately from the database.
ENCRYPTION_KEY=""

# Server-side salt for hashing IP addresses (raw IPs are never stored).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""

# Secret for signing the Data Rights session cookie and hashing one-time codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Admin users: comma-separated username:role:hash. Roles: admin, dpo, reception.
# Generate an entry: npm run admin:hash-password -- <username> <role> <password>
ADMIN_USERS=""

# ---------------------------------------------------------------------------
# Transport, proxy and test-environment flags (see src/lib/env.js)
# ---------------------------------------------------------------------------
# HSTS, upgrade-insecure-requests and Secure cookies. Only honoured with
# NODE_ENV=production. Set it for `next build` too (headers are fixed at build time).
# Leave unset for a production build served over plain HTTP in a test environment.
FORCE_HTTPS="false"

# Use X-Forwarded-For for the client IP. Only behind a reverse proxy that overwrites it.
TRUST_PROXY="false"

# Show one-time codes on screen ("Test environment" label) instead of sending them.
# Refused when NODE_ENV=production unless ALLOW_DEMO_IN_PROD=true. RISK: anyone who knows
# a reference ID and the registered phone/email can then open that person's records.
DEMO_MODE="false"
ALLOW_DEMO_IN_PROD="false"
